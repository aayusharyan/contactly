# Contactly - Docker Ignore Configuration
#
# Controls which files are excluded from the Docker build context.
# Reduces image size and build time by preventing unnecessary files
# from being sent to the Docker daemon.
#
# Standard FOSS practice: Exclude version control, local configs, and non-production files

# Version control
# Git repository should not be included in Docker images
.git/
.gitignore

# Python cache
# These are regenerated in the container and should be created fresh
__pycache__/
*.pyc
*.pyo

# Local environment (not needed in container)
# Credentials should be mounted at runtime or passed as env vars
.env

# OAuth credentials (mount at runtime)
# These should be provided via volumes or environment variables, not baked into the image
credentials.json
token.json

# Local database files (use volumes)
# Data persistence should use Docker volumes, not be baked into the image
*.db
*.sqlite

# IDE settings
# Development tool configurations don't belong in production images
.vscode/
.idea/

# Documentation (most not needed in container)
# Keep only README for reference, exclude other docs to reduce image size
*.md
!README.md

# OS files
# Platform-specific metadata files
.DS_Store

# Docker files (not needed inside image)
# These are used to build the image, not needed inside it
docker-compose.yml
docker-compose.example.yml
.dockerignore

# GitHub workflows
# CI/CD configurations don't belong in the image
.github/

# Cursor AI settings
# Editor-specific configurations
.cursor/
