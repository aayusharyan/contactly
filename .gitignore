# Contactly - Git Ignore Configuration
#
# Specifies files and directories that should not be tracked by Git.
# Keeps the repository clean by preventing sensitive data, build artifacts,
# and environment-specific files from being committed.
#
# Standard FOSS practice: Never commit credentials, local configs, or generated files

# Python cache and compiled files
# These are automatically regenerated and platform-specific
__pycache__/
*.pyc
*.pyo

# Environment configuration (for developers)
# Contains sensitive credentials and local settings
.env

# OAuth credentials (NEVER commit these!)
# These files contain sensitive authentication tokens
credentials.json
token.json

# Local SQLite database
# Runtime data that shouldn't be shared
contacts_sync.db

# IDE settings
# User-specific editor configurations
.vscode/
.idea/

# OS files
# macOS metadata files
.DS_Store

# User's docker-compose with real credentials
# The example file is tracked, but users' actual configs with real credentials are not
docker-compose.yml
